@{
    ViewData["Title"] = "Minha Faculdade";
}

<div class="hero">
    <div>
        <span class="badge">PORTAL ACADÊMICO</span>

        <h1>Minha Faculdade</h1>

        <p>
            Acesse seus cursos e consulte informações acadêmicas
            de forma rápida e simples.
        </p>
    </div>
</div>

<section class="courses-section">

    <div class="section-header">
        <div>
            <h2>Meus Cursos</h2>
            <p>Confira os cursos disponíveis na faculdade.</p>
        </div>

        <span class="course-count">3 cursos</span>
    </div>

    <div class="course-grid">

        <div class="course-card">
            <div class="course-icon">💻</div>

            <div class="course-content">
                <span class="course-tag">TECNOLOGIA</span>
                <h3>Engenharia de Software</h3>
                <p>
                    Desenvolvimento de sistemas, programação,
                    banco de dados e engenharia de software.
                </p>

                <a href="/Cursos/Detalhes/1" class="course-button">
                    Ver detalhes →
                </a>
            </div>
        </div>

        <div class="course-card">
            <div class="course-icon">📊</div>

            <div class="course-content">
                <span class="course-tag">NEGÓCIOS</span>
                <h3>Administração</h3>
                <p>
                    Gestão, negócios, planejamento estratégico
                    e administração de empresas.
                </p>

                <a href="/Cursos/Detalhes/2" class="course-button">
                    Ver detalhes →
                </a>
            </div>
        </div>

        <div class="course-card">
            <div class="course-icon">🧬</div>

            <div class="course-content">
                <span class="course-tag">SAÚDE</span>
                <h3>Fisioterapia</h3>
                <p>
                    Estudo do movimento humano, saúde,
                    reabilitação e qualidade de vida.
                </p>

                <a href="/Cursos/Detalhes/3" class="course-button">
                    Ver detalhes →
                </a>
            </div>
        </div>

    </div>

</section>